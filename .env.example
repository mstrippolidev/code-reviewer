OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=deepseek-r1:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CODE_EMBED_MODEL=manutic/nomic-embed-code:7b-Q4_K_M
OLLAMA_EMBED_NUM_CTX=8192

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Judge panel for exemplar promotion: comma-separated OpenRouter model ids.
# Use at least three, and pick each from a DIFFERENT model family. A judge
# that shares weights with whatever produced the code it judges favours that
# output, and the effect survives hiding the authorship — so resampling one
# model at a higher temperature is not a substitute for three families.
OPENROUTER_JUDGE_MODELS=

PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=code-reviewer
PG_USER=code_reviewer_app
PG_PASSWORD=

ENVIRONMENT=local

MAX_SUBMISSION_CHARACTERS=200000
MAX_FILES_PER_SUBMISSION=15

MAX_FILE_LINES=1500

GUARDRAILS_API_KEY=

MAX_BATCH_CONCURRENCY=4
MAX_DISPATCH_CONCURRENCY=4


EXEMPLAR_RELEVANCE_FLOOR=0.5
EXEMPLAR_TOP_K=2

# Cross-encoder re-rank score floor for DRY's cross-history candidates.
# Provisional, same as EXEMPLAR_RELEVANCE_FLOOR — this is a raw
# cross-encoder/ms-marco-MiniLM-L-6-v2 score, not a cosine similarity, and
# needs its own calibration once real fixtures are run against it.
DRY_RERANK_SCORE_FLOOR=0.5

# Hard ceiling on one LLM call, in seconds, enforced per-provider (Ollama via
# client_kwargs, OpenRouter via request_timeout — different providers expose
# this under different names, so there is no single shared kwarg for it).
LLM_CALL_TIMEOUT_SECONDS=60