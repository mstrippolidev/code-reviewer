{
 "uid": "agent-quality",
 "title": "Agent quality",
 "tags": [
  "code-reviewer"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Empty-result share by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_code_key) (rate(code_reviewer_agent_results_total{code_reviewer_result=\"empty\"}[1h])) / sum by (code_reviewer_code_key) (rate(code_reviewer_agent_results_total[1h]))",
     "legendFormat": "{{code_reviewer_code_key}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Mean rating by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_code_key) (rate(code_reviewer_agent_rating_sum[1h])) / sum by (code_reviewer_code_key) (rate(code_reviewer_agent_rating_count[1h]))",
     "legendFormat": "{{code_reviewer_code_key}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Review rating",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(code_reviewer_review_rating_bucket[1h])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "sum(rate(code_reviewer_review_rating_sum[1h])) / sum(rate(code_reviewer_review_rating_count[1h]))",
     "legendFormat": "mean"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Incidents by priority, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_priority) (increase(code_reviewer_agent_incidents_total[1h]))",
     "legendFormat": "{{code_reviewer_priority}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Incidents by agent, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_code_key) (increase(code_reviewer_agent_incidents_total[1h]))",
     "legendFormat": "{{code_reviewer_code_key}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Agents that overlap most (agent pairs), per 6 hours",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, sum by (code_reviewer_agent_pair) (increase(code_reviewer_agent_incident_overlaps_total[6h])))",
     "legendFormat": "{{code_reviewer_agent_pair}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Invalid line positions by agent, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_code_key) (increase(code_reviewer_agent_invalid_line_positions_total[1h]))",
     "legendFormat": "{{code_reviewer_code_key}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Model turns p95 by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, code_reviewer_code_key) (rate(code_reviewer_agent_model_turns_bucket[1h])))",
     "legendFormat": "{{code_reviewer_code_key}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Tool calls by tool and status, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_tool, code_reviewer_tool_status) (increase(code_reviewer_agent_tool_calls_total[1h]))",
     "legendFormat": "{{code_reviewer_tool}} {{code_reviewer_tool_status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "TCASE test-file lookups by result, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_result) (increase(code_reviewer_rag_pairing_lookups_total[1h]))",
     "legendFormat": "{{code_reviewer_result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "ARCH/COUP evidence lookups by result, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_result) (increase(code_reviewer_rag_evidence_lookups_total[1h]))",
     "legendFormat": "{{code_reviewer_result}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "DRY judge verdicts, per hour",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code_reviewer_verdict) (increase(code_reviewer_rag_dry_judge_verdicts_total[1h]))",
     "legendFormat": "{{code_reviewer_verdict}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ]
}
